# Copy to .env and edit. .env is gitignored; commit .env.example only.

# Where runtime data lives (jarlog.db, photos/). Relative paths resolve
# against the project root. Default: ./data
JARLOG_DATA_DIR=./data

# Bind address. Use 0.0.0.0 to reach it from a phone on the LAN.
JARLOG_HOST=127.0.0.1
JARLOG_PORT=8420

# Timestamps are stored in UTC and displayed in this zone.
JARLOG_TZ=America/New_York
