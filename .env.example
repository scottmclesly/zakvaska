# Copy to .env and edit. .env is gitignored; commit .env.example only.

# Where runtime data lives (zakvaska.db, photos/). Relative paths resolve
# against the project root. Default: ./data
ZAKVASKA_DATA_DIR=./data

# Bind address. Use 0.0.0.0 to reach it from a phone on the LAN.
ZAKVASKA_HOST=127.0.0.1
ZAKVASKA_PORT=8420

# Timestamps are stored in UTC and displayed in this zone.
ZAKVASKA_TZ=America/New_York

# The in-process job that fires feeding alerts, once a minute.
# Set to 0 to run the app without it.
ZAKVASKA_SCHEDULER=1

# Bring the database schema up to date as the app starts, copying
# zakvaska.db beside itself first whenever there is something to change.
# Leave this on; 0 is for the test suite.
ZAKVASKA_MIGRATE=1
