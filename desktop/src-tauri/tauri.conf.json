{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zakvaska",
  "identifier": "io.github.scottmclesly.zakvaska",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "A lab notebook for sourdough starters and bakes",
    "copyright": "Copyright (c) 2026 Scottsky. MIT licence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/zakvaska-server/": "server/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
